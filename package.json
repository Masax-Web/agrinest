{
  "name": "agri-nest",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3001",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "start": "node db/run_jicho_migration.js && node api/server.js",
    "start:static": "npx http-server www -p 8080 -c-1 --cors",
    "web:build": "vite build",
    "web:serve": "vite --host 0.0.0.0 --port 3000",
    "web": "npm run web:serve",
    "react:dev": "vite --host 0.0.0.0 --port 3000",
    "react:build": "vite build",
    "react:preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "electron:dev": "npm run react:build && electron .",
    "electron:build": "npm run react:build && electron-builder",
    "mock-api": "node api/mock_server.js",
    "api:start": "node db/run_jicho_migration.js && node api/server.js",
    "api:test": "node api/test-endpoints.js",
    "migrate": "node ./db/run_migrations.js",
    "build:web": "vite build",
    "build:web:py": "powershell -ExecutionPolicy Bypass -File tools/build-web-ps.ps1",
    "prepare": "vite build",
    "cap:init": "npx cap init agri-nest com.agri.nest --web-dir=www",
    "verify": "node tools/verify-app.js",
    "check:routes": "node tools/health-check.js http://localhost:8080",
    "test:integration": "mocha --timeout 20000 tests/integration/**/*.js",
    "test": "npm run test:integration"
  },
  "build": {
    "appId": "com.agri.nest",
    "productName": "AGRI-NEST",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "ajv-formats": "^2.1.1",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-openapi-validator": "^5.6.2",
    "knex": "^2.4.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^4.7.1",
    "nodemailer": "^6.9.4",
    "pg": "^8.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4",
    "twilio": "^4.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "chai": "^4.3.8",
    "electron": "^26.2.0",
    "electron-builder": "^24.6.0",
    "fs-extra": "^11.1.1",
    "http-server": "^14.1.1",
    "mocha": "^11.8.0",
    "supertest": "^6.3.3",
    "vite": "^5.4.2"
  },
  "allowScripts": {
    "electron@26.2.0": true,
    "esbuild@0.21.5": true
  }
}
